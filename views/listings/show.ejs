<script>
  maptilersdk.config.apiKey = 'ganng8E9mSnQWKQFgF20';

    let coords;

  try {
    const raw = <%- JSON.stringify(listing.geometry?.coordinates || null) %>;

    if (
      raw &&
      Array.isArray(raw) &&
      raw.length === 2 &&
      !isNaN(raw[0]) &&
      !isNaN(raw[1])
    ) {
      coords = raw;
    } else {
      throw new Error("Invalid coords");
    }
  } catch (e) {
    console.warn("Using fallback coords");
    coords = [78.4867, 17.3850]; // Hyderabad
  }

  console.log("FINAL COORDS:", coords);

  const map = new maptilersdk.Map({
    container: 'map',
    style: maptilersdk.MapStyle.STREETS,
    center: coords,
    zoom: 15
  });

  const popup = new maptilersdk.Popup({ offset: 25 }).setHTML(`
  <b><%= listing.title %></b><br>
    ₹ <%= listing.price %><br>
    <%= listing.location %>, <%= listing.country %>
  `);
  
  new maptilersdk.Marker()
    .setLngLat(coords)
    .setPopup(popup)
    .addTo(map);
</script>